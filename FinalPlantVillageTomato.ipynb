# LATEX TABLE
# ----------------------------------------------------------

print("\nLATEX TABLE\n")

print(
    cross_df.to_latex(
        float_format="%.4f",
        caption=
        "Cross-dataset evaluation using PlantVillage for training and PlantDocTomato for testing.",
        label=
        "tab:cross_dataset"
    )
)
