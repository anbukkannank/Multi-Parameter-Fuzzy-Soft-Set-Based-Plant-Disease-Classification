import os
import cv2
import numpy as np
import pandas as pd

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    roc_auc_score
)

# ----------------------------------------------------------
# MODIFY THIS PATH
# ----------------------------------------------------------

PLANTDOC_TEST_DIR = "/content/drive/MyDrive/PlantDocTomatoDataset"

# ----------------------------------------------------------
# LOAD PLANTDOC DATASET
# ----------------------------------------------------------

def load_plantdoc_dataset(base_dir,
                          img_size=(128,128)):

    images = []
    labels = []

    folders = sorted(os.listdir(base_dir))

    print("\nPlantDoc Classes:")
    print(folders)

    for folder in folders:

        folder_path = os.path.join(base_dir, folder)

        if not os.path.isdir(folder_path):
            continue

        # Healthy = 0
        # Everything else = Diseased = 1

        if folder == "Healthy":
            label = 0
        else:
            label = 1

        image_files = [
            f for f in os.listdir(folder_path)
            if f.lower().endswith(
                ('.jpg','.jpeg','.png')
            )
        ]

        for file in image_files:

            img_path = os.path.join(
                folder_path,
                file
            )

            try:

                img = cv2.imread(img_path)

                if img is None:
                    continue

                img = cv2.resize(
                    img,
                    img_size
                )

                images.append(img)
                labels.append(label)

            except:
                continue

    return (
        np.array(images),
        np.array(labels)
    )

